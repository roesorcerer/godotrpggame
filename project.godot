; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Eggshells"
run/main_scene="uid://cq025adw7oyrl"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameState="*res://autoload/game_state.gd"
GameClock="*res://autoload/game_clock.gd"
SceneRouter="*res://autoload/scene_router.gd"
Mom="*res://autoload/mom.gd"
ChoreSystem="*res://autoload/chore_system.gd"
QuestSystem="*res://autoload/quest_system.gd"
Inventory="*res://autoload/inventory.gd"
Cooking="*res://autoload/cooking.gd"
SaveSystem="*res://autoload/save_system.gd"
HUD="*res://ui/hud/hud.tscn"
Data="*uid://bccw0chb2ebmh"
Enum="*uid://bqrnnyc50l2mx"
DialogueManager="*uid://c3rodes2l3gxb"

[debug]

gdscript/warnings/unused_signal=0

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/script_splitter/plugin.cfg")

[file_customization]

folder_colors={
"res://actors/": "orange",
"res://art_library/": "gray",
"res://autoload/": "red",
"res://core/": "red",
"res://data/": "yellow",
"res://dev/": "gray",
"res://props/": "green",
"res://tilesets/": "teal",
"res://ui/": "purple",
"res://world/": "blue"
}


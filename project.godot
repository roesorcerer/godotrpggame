; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="stardewclone"
run/main_scene="uid://cq025adw7oyrl"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameState="*res://autoload/game_state.gd"
GameClock="*res://autoload/game_clock.gd"
SceneRouter="*res://autoload/scene_router.gd"
MessSystem="*res://autoload/mess_system.gd"
ChoreSystem="*res://autoload/chore_system.gd"
CourseworkSystem="*res://autoload/coursework_system.gd"
HUD="*res://scenes/ui/hud.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[file_customization]

folder_colors={
"res://assets/": "pink"
}

